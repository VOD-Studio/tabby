---
import { Icon } from '@astrojs/starlight/components';
import SiteLayout from '../layouts/SiteLayout.astro';
import overview from '../assets/overview.webp';
import { sitePath } from '../links';

const screenshotDescription = 'Tabby 的终端概览页，显示实时流量、代理模式、连接数和内核状态';
const guides = [
  { title: '连接已有内核', icon: 'setting', detail: '已有 mihomo？用控制器的地址和密钥连接。', href: sitePath('/docs/quick-start/connect/') },
  { title: '让 Tabby 托管内核', icon: 'rocket', detail: '由 Tabby 安装、启动和升级 mihomo，再导入第一份订阅。', href: sitePath('/docs/quick-start/managed/') },
] as const;
---

<SiteLayout title="Tabby · 终端里的 mihomo 控制台" description="在 Linux 和 macOS 上用中文终端界面管理 mihomo。支持连接现有内核或托管内核。">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-inner site-width">
      <div class="hero-copy">
        <p class="platforms">Linux / macOS</p>
        <h1 id="hero-title">在终端里，<br />掌控 <em>mihomo</em>。</h1>
        <p class="hero-description">用中文终端界面切换代理、查看实时流量和连接。可以连接已有内核，也可以交给 Tabby 托管。</p>
        <div class="actions">
          <a class="action primary" href="#quick-start">快速开始</a>
          <a class="action" href={sitePath('/download/')}>下载 Tabby</a>
        </div>
      </div>
      <figure class="terminal">
        <a href={overview.src} id="open-overview" aria-label="查看终端概览大图">
          <img src={overview.src} alt={screenshotDescription} width={overview.width} height={overview.height} fetchpriority="high" />
        </a>
        <figcaption>概览页 · 点开查看大图</figcaption>
      </figure>
    </div>
  </section>

  <section class="start" id="quick-start" aria-labelledby="start-title">
    <div class="site-width">
      <h2 id="start-title">选择你的使用方式</h2>
      <div class="guide-list">
        {guides.map(({ title, icon, detail, href }) => (
          <a class="guide" href={href}>
            <Icon name={icon} />
            <div><h3>{title}</h3><p>{detail}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="site-width capabilities" aria-label="Tabby 功能">
    <article><h2>管理代理</h2><p>切换节点、测速、更新 Providers，按规则和连接定位流量去向。</p></article>
    <article><h2>实时查看</h2><p>跟踪流量、活跃连接和内核日志，断线后自动重连。</p></article>
    <article><h2>键盘操作</h2><p>用数字键切换页面，按 <kbd>?</kbd> 查看当前页面的快捷键。</p></article>
  </section>

  <dialog id="overview-dialog" aria-label="Tabby 终端概览大图">
    <div class="dialog-controls"><form method="dialog"><button class="action" autofocus>关闭大图</button></form></div>
    <img src={overview.src} alt={screenshotDescription} width={overview.width} height={overview.height} loading="lazy" />
  </dialog>
</SiteLayout>

<script>
  const trigger = document.querySelector<HTMLAnchorElement>('#open-overview');
  const dialog = document.querySelector<HTMLDialogElement>('#overview-dialog');
  if (trigger && dialog && typeof dialog.showModal === 'function') {
    trigger.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      dialog.showModal();
    });
    dialog.addEventListener('close', () => trigger.focus());
  }
</script>

<style>
  .hero { background: radial-gradient(ellipse at 79% 48%, var(--tabby-glow) 0%, transparent 64%); }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.87fr) minmax(0, 1.13fr);
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(3.1rem, 6.5vw, 6rem) clamp(2.75rem, 5.2vw, 5rem);
  }
  .platforms {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1rem;
    color: var(--tabby-muted);
    font: 0.8rem/1.3 var(--tabby-mono);
    letter-spacing: 0.03em;
  }
  .platforms::before { content: ''; width: 1.1rem; height: 1px; background: var(--tabby-accent); }
  h1 { margin: 0; font-size: clamp(2.35rem, 5.35vw, 5rem); line-height: 1.16; font-weight: 760; letter-spacing: -0.077em; }
  h1 em { color: var(--tabby-accent); font-style: normal; letter-spacing: -0.074em; }
  .hero-description { max-width: 27em; margin: 1.4rem 0 1.7rem; color: var(--tabby-muted); font-size: clamp(1rem, 1.4vw, 1.125rem); text-wrap: pretty; }
  .terminal { min-width: 0; margin: 0; }
  .terminal a { display: block; border-radius: 0.8rem; cursor: zoom-in; }
  .terminal img { display: block; width: 100%; height: auto; filter: drop-shadow(0 1.4rem 1.65rem var(--tabby-shadow)); }
  figcaption { color: var(--tabby-muted); text-align: center; font-size: 0.8rem; }
  .start { border-block: 1px solid var(--tabby-border); padding-block: clamp(1.5rem, 3vw, 2.5rem); }
  h2, h3 { margin: 0; }
  .start h2 { font-size: 1.25rem; line-height: 1.4; letter-spacing: -0.025em; }
  .guide-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; margin-top: 1rem; }
  .guide {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.03rem 1.15rem;
    border: 1px solid var(--tabby-border);
    border-radius: 0.65rem;
    background: var(--tabby-surface);
    text-decoration: none;
  }
  .guide:hover { border-color: var(--tabby-accent); }
  .guide :global(svg) { flex: 0 0 1.15rem; height: 1.15rem; margin-top: 0.22rem; color: var(--tabby-accent); }
  .guide h3 { font-size: 1rem; }
  .guide p, .capabilities p { margin: 0.25rem 0 0; color: var(--tabby-muted); font-size: 0.95rem; }
  .capabilities { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.2rem, 4vw, 3.25rem); padding-block: clamp(2.4rem, 5vw, 4.5rem); }
  .capabilities h2 { font-size: 1.08rem; }
  kbd { padding: 0.04em 0.32em; border: 1px solid var(--tabby-border); border-radius: 0.28em; font-family: var(--tabby-mono); }
  dialog { max-width: min(95vw, 79rem); max-height: 95dvh; padding: 0.8rem; border: 1px solid var(--tabby-border); border-radius: 0.85rem; background: var(--tabby-bg); }
  dialog::backdrop { background: #060504c9; }
  .dialog-controls { display: flex; justify-content: flex-end; }
  dialog img { display: block; width: auto; max-width: 100%; height: auto; max-height: 82dvh; object-fit: contain; }
  @media (max-width: 45rem) {
    .hero-inner { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .terminal { max-width: 36rem; }
  }
  @media (max-width: 35rem) {
    .guide-list, .capabilities { grid-template-columns: minmax(0, 1fr); }
  }
</style>
